# ==========================================
# Portfolio API - Environment Variables
# ==========================================

# --- Security Settings ---
# Generate a real secret key in production using: openssl rand -hex 32
SECRET_KEY="dummy-secret-key-for-local-dev-only-do-not-use-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Admin Credentials ---
ADMIN_USERNAME="local_admin"
ADMIN_PASSWORD="local_password_123"

# --- Application Settings ---
PROJECT_NAME="Portfolio API"
PROJECT_VERSION="1.1.0"
ENVIRONMENT="development" # Options: development / production

# --- File Storage & Upload Settings ---
MEDIA_ROOT="uploads"       # Physical directory path on disk
MEDIA_URL="/uploads"       # Public URL prefix served by the backend
MAX_IMAGE_SIZE_BYTES=5242880 # Maximum upload size in bytes (5 MB)

# Database Connection:
# SQLite (Local development / testing fallback):
# DATABASE_URL="sqlite:///./portfolio.db"
# PostgreSQL (Production / Neon Cloud):
DATABASE_URL="postgresql+psycopg2://<user>:<password>@<ep-xyz>.<region>.neon.tech/<dbname>?sslmode=require"